{
  "name": "local-lg-tv-remote",
  "version": "1.0.0",
  "description": "An LG webOS and NetCast remote with local pairing and optional family link sharing.",
  "main": "server.js",
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "start:bg": "node scripts/server-manager.js start",
    "start:phone": "node scripts/server-manager.js start --host=0.0.0.0",
    "stop": "node scripts/server-manager.js stop",
    "status": "node scripts/server-manager.js status",
    "android:prepare": "node scripts/prepare-android.js",
    "android:apk": "node scripts/build-android-sdk.js",
    "android:signing": "node scripts/android-signing.js",
    "android:build": "node scripts/prepare-android.js && node scripts/android-signing.js && cd android && ./gradlew assembleRelease"
  },
  "keywords": [
    "lg",
    "webos",
    "tv",
    "remote",
    "local"
  ],
  "author": "Arman Singh",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
